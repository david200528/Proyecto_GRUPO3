<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="sigelab.view.PeriodoAcademicoForm">
  <grid id="periodRoot" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="10" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="8" left="8" bottom="8" right="8"/><constraints><xy x="20" y="20" width="700" height="500"/></constraints><properties/><border type="none"/><children>
      <component id="pTitle" class="javax.swing.JLabel"><constraints><grid row="0" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="ADMINISTRACION DE PERIODOS ACADEMICOS"/></properties></component>
      <component id="pId" class="javax.swing.JTextField" binding="txtId"><constraints><grid row="1" column="1" row-span="1" col-span="3" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/></component>
      <component id="pName" class="javax.swing.JTextField" binding="txtNombre"><constraints><grid row="2" column="1" row-span="1" col-span="3" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/></component>
      <component id="pStart" class="com.toedter.calendar.JDateChooser" binding="dcFechaInicio" custom-create="true"><constraints><grid row="3" column="1" row-span="1" col-span="3" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><toolTipText value="Seleccione la fecha de inicio"/></properties></component>
      <component id="pEnd" class="com.toedter.calendar.JDateChooser" binding="dcFechaFin" custom-create="true"><constraints><grid row="4" column="1" row-span="1" col-span="3" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><toolTipText value="Seleccione la fecha de fin"/></properties></component>
      <component id="pIdL" class="javax.swing.JLabel"><constraints><grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="ID"/></properties></component>
      <component id="pNameL" class="javax.swing.JLabel"><constraints><grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Nombre"/></properties></component>
      <component id="pStartL" class="javax.swing.JLabel"><constraints><grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Fecha inicio"/></properties></component>
      <component id="pEndL" class="javax.swing.JLabel"><constraints><grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Fecha fin"/></properties></component>
      <component id="pActiveL" class="javax.swing.JLabel"><constraints><grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Activo"/></properties></component>
      <component id="pActive" class="javax.swing.JCheckBox" binding="chkActivo"><constraints><grid row="5" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties/></component>
      <component id="pNew" class="javax.swing.JButton" binding="btnNuevo"><constraints><grid row="6" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="Nuevo"/></properties></component>
      <component id="pSave" class="javax.swing.JButton" binding="btnGuardar"><constraints><grid row="6" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="Guardar"/></properties></component>
      <component id="pUpdate" class="javax.swing.JButton" binding="btnActualizar"><constraints><grid row="6" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="Actualizar"/></properties></component>
      <component id="pState" class="javax.swing.JButton" binding="btnDesactivar"><constraints><grid row="6" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="Desactivar"/></properties></component>
      <component id="pSearchL" class="javax.swing.JLabel"><constraints><grid row="7" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Buscar por nombre"/></properties></component>
      <component id="pSearch" class="javax.swing.JTextField" binding="txtBuscar"><constraints><grid row="7" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/></component>
      <component id="pFind" class="javax.swing.JButton" binding="btnBuscar"><constraints><grid row="7" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="Buscar"/></properties></component>
      <scrollpane id="pScroll"><constraints><grid row="8" column="0" row-span="1" col-span="4" vsize-policy="6" hsize-policy="6" anchor="0" fill="3" indent="0" use-parent-layout="false"/></constraints><properties/><border type="none"/><children><component id="pTable" class="javax.swing.JTable" binding="tblPeriodos"><constraints/><properties/></component></children></scrollpane>
      <component id="pExit" class="javax.swing.JButton" binding="btnSalir"><constraints><grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="SALIR"/></properties></component>
    </children>
  </grid>
</form>
