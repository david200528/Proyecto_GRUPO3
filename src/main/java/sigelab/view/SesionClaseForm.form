<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="sigelab.view.SesionClaseForm">
  <grid id="sessionRoot" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="13" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="8" left="8" bottom="8" right="8"/><constraints><xy x="20" y="20" width="850" height="600"/></constraints><properties/><border type="none"/><children>
      <component id="seTitle" class="javax.swing.JLabel"><constraints><grid row="0" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="ADMINISTRACION DE SESIONES DE CLASE"/></properties></component>
      <component id="seId" class="javax.swing.JTextField" binding="txtId"><constraints><grid row="1" column="1" row-span="1" col-span="3" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/></component>
      <component id="seSec" class="javax.swing.JComboBox" binding="cmbSeccion"><constraints><grid row="2" column="1" row-span="1" col-span="3" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/></component>
      <component id="seSch" class="javax.swing.JComboBox" binding="cmbHorario"><constraints><grid row="3" column="1" row-span="1" col-span="3" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/></component>
      <component id="seDate" class="com.toedter.calendar.JDateChooser" binding="dcFecha" custom-create="true"><constraints><grid row="4" column="1" row-span="1" col-span="3" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><toolTipText value="Seleccione la fecha"/></properties></component>
      <component id="seStart" class="javax.swing.JSpinner" binding="spnHoraInicio"><constraints><grid row="5" column="1" row-span="1" col-span="3" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><toolTipText value="Hora en formato HH:mm"/></properties></component>
      <component id="seEnd" class="javax.swing.JSpinner" binding="spnHoraFin"><constraints><grid row="6" column="1" row-span="1" col-span="3" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><toolTipText value="Hora en formato HH:mm"/></properties></component>
      <component id="seRoom" class="javax.swing.JTextField" binding="txtAula"><constraints><grid row="7" column="1" row-span="1" col-span="3" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/></component>
      <component id="seStateCombo" class="javax.swing.JComboBox" binding="cmbEstado"><constraints><grid row="8" column="1" row-span="1" col-span="3" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/></component>
      <component id="seIdL" class="javax.swing.JLabel"><constraints><grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="ID"/></properties></component>
      <component id="seSecL" class="javax.swing.JLabel"><constraints><grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Sección"/></properties></component>
      <component id="seSchL" class="javax.swing.JLabel"><constraints><grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Horario semanal"/></properties></component>
      <component id="seDateL" class="javax.swing.JLabel"><constraints><grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Fecha"/></properties></component>
      <component id="seStartL" class="javax.swing.JLabel"><constraints><grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Hora inicio"/></properties></component>
      <component id="seEndL" class="javax.swing.JLabel"><constraints><grid row="6" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Hora fin"/></properties></component>
      <component id="seRoomL" class="javax.swing.JLabel"><constraints><grid row="7" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Aula"/></properties></component>
      <component id="seStateL" class="javax.swing.JLabel"><constraints><grid row="8" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Estado"/></properties></component>
      <component id="seNew" class="javax.swing.JButton" binding="btnNuevo"><constraints><grid row="9" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="Nuevo"/></properties></component>
      <component id="seSave" class="javax.swing.JButton" binding="btnGuardar"><constraints><grid row="9" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="Guardar"/></properties></component>
      <component id="seUpdate" class="javax.swing.JButton" binding="btnActualizar"><constraints><grid row="9" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="Actualizar"/></properties></component>
      <component id="seState" class="javax.swing.JButton" binding="btnCambiarEstado"><constraints><grid row="9" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="Cambiar estado"/></properties></component>
      <component id="seGenerate" class="javax.swing.JButton" binding="btnGenerar"><constraints><grid row="10" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="Generar sesiones"/></properties></component>
      <component id="seSearchL" class="javax.swing.JLabel"><constraints><grid row="10" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Buscar ID"/></properties></component>
      <component id="seSearch" class="javax.swing.JTextField" binding="txtBuscar"><constraints><grid row="10" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/></component>
      <component id="seFind" class="javax.swing.JButton" binding="btnBuscar"><constraints><grid row="10" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="Buscar"/></properties></component>
      <scrollpane id="seScroll"><constraints><grid row="11" column="0" row-span="1" col-span="4" vsize-policy="6" hsize-policy="6" anchor="0" fill="3" indent="0" use-parent-layout="false"/></constraints><properties/><border type="none"/><children><component id="seTable" class="javax.swing.JTable" binding="tblSesiones"><constraints/><properties/></component></children></scrollpane>
      <component id="seExit2" class="javax.swing.JButton" binding="btnSalir"><constraints><grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="SALIR"/></properties></component>
    </children>
  </grid>
</form>
