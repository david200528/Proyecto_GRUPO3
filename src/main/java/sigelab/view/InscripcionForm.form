<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="view.sigelab.InscripcionForm">
  <grid id="enrollRoot" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="11" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="8" left="8" bottom="8" right="8"/><constraints><xy x="20" y="20" width="850" height="540"/></constraints><properties/><border type="none"/><children>
      <component id="iTitle" class="javax.swing.JLabel"><constraints><grid row="0" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="ADMINISTRACION DE INSCRIPCIONES"/></properties></component>
      <component id="iId" class="javax.swing.JTextField" binding="txtId"><constraints><grid row="1" column="1" row-span="1" col-span="3" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/></component>
      <component id="iStudent" class="javax.swing.JComboBox" binding="cmbEstudiante"><constraints><grid row="2" column="1" row-span="1" col-span="3" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/></component>
      <component id="iSection" class="javax.swing.JComboBox" binding="cmbSeccion"><constraints><grid row="3" column="1" row-span="1" col-span="3" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/></component>
      <component id="iDate" class="com.toedter.calendar.JDateChooser" binding="dcFechaInscripcion" custom-create="true"><constraints><grid row="4" column="1" row-span="1" col-span="3" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><toolTipText value="Fecha de inscripción"/></properties></component>
      <component id="iWithdraw" class="com.toedter.calendar.JDateChooser" binding="dcFechaRetiro" custom-create="true"><constraints><grid row="5" column="1" row-span="1" col-span="3" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><toolTipText value="Fecha de retiro"/></properties></component>
      <component id="iIdL" class="javax.swing.JLabel"><constraints><grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="ID"/></properties></component>
      <component id="iStudentL" class="javax.swing.JLabel"><constraints><grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Estudiante"/></properties></component>
      <component id="iSectionL" class="javax.swing.JLabel"><constraints><grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Sección"/></properties></component>
      <component id="iDateL" class="javax.swing.JLabel"><constraints><grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Fecha inscripción"/></properties></component>
      <component id="iWithdrawL" class="javax.swing.JLabel"><constraints><grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Fecha retiro"/></properties></component>
      <component id="iActiveL" class="javax.swing.JLabel"><constraints><grid row="6" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Activa"/></properties></component>
      <component id="iActive" class="javax.swing.JCheckBox" binding="chkActiva"><constraints><grid row="6" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties/></component>
      <component id="iNew" class="javax.swing.JButton" binding="btnNuevo"><constraints><grid row="7" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="Nueva"/></properties></component>
      <component id="iSave" class="javax.swing.JButton" binding="btnGuardar"><constraints><grid row="7" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="Guardar"/></properties></component>
      <component id="iUpdate" class="javax.swing.JButton" binding="btnActualizar"><constraints><grid row="7" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="Actualizar"/></properties></component>
      <component id="iRetire" class="javax.swing.JButton" binding="btnRetirar"><constraints><grid row="7" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="Retirar"/></properties></component>
      <component id="iSearchL" class="javax.swing.JLabel"><constraints><grid row="8" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Buscar por ID"/></properties></component>
      <component id="iSearch" class="javax.swing.JTextField" binding="txtBuscar"><constraints><grid row="8" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/></component>
      <component id="iFind" class="javax.swing.JButton" binding="btnBuscar"><constraints><grid row="8" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="Buscar"/></properties></component>
      <scrollpane id="iScroll"><constraints><grid row="9" column="0" row-span="1" col-span="4" vsize-policy="6" hsize-policy="6" anchor="0" fill="3" indent="0" use-parent-layout="false"/></constraints><properties/><border type="none"/><children><component id="iTable" class="javax.swing.JTable" binding="tblInscripciones"><constraints/><properties/></component></children></scrollpane>
      <component id="iExit" class="javax.swing.JButton" binding="btnSalir"><constraints><grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="SALIR"/></properties></component>
    </children>
  </grid>
</form>
